# Copy to .env (git-ignored) for `composer serve`. Generate APP_KEY with:
#   echo "APP_KEY=base64:$(head -c 32 /dev/urandom | base64)"
APP_KEY=
APP_ENV=local
APP_DEBUG=true

# The project key from platform.openai.com. Set a monthly spend cap on the project first.
OPENAI_API_KEY=

# openai-live for the real spike; fake to try the page without spending anything.
DO_INTERVIEW_VOICE_DRIVER=openai-live
# GPT-Live voices to try: vesper (British), willow or stone (Irish), quartz (Australian).
DO_INTERVIEW_VOICE=vesper
DO_INTERVIEW_SPIKE_MAX_SECONDS=300
